{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "warikan",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // これが無いと /api/* まで index.html にフォールバックして API が死ぬ。
    // 配列で渡したパターンだけ Worker が先に処理し、残りは Asset Worker が返す。
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warikan-db",
      "database_id": "ae7fa5aa-6edd-4627-bf5b-babd534bbdac",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "lively-sun-75f1.cloudflareaccess.com"
  }
}

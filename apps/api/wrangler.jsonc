{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "warikan",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warikan-db",
      "database_id": "ae7fa5aa-6edd-4627-bf5b-babd534bbdac",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": ""
  }
}
